{
  "name": "html-boilerplate",
  "version": "1.0.0",
  "author": "shela",
  "licenses": [
    {
      "type": "Apache-2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    }
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "clean": "bun --eval \"fs.rmSync('public', { recursive: true, force: true })\"",
    "imagemin": "bun scripts/imagemin.mjs",
    "serve": "bun scripts/dev-server.mjs",
    "build:css": "NODE_ENV=production postcss src/assets/css/*.pcss --config postcss.config.mjs --dir public/css/ --ext css",
    "build:html": "bun scripts/build-eta.mjs",
    "build:images": "bun run imagemin",
    "build": "run-p build:css build:html build:images",
    "watch:css": "NODE_ENV=development postcss src/assets/css/*.pcss --watch --config postcss.config.mjs --dir public/css/ --ext css",
    "watch:html": "bun scripts/watch-eta.mjs",
    "watch": "run-p serve watch:*"
  },
  "devDependencies": {
    "cssnano": "^8.0.1",
    "eta": "^4.6.0",
    "npm-run-all2": "^9.0.0",
    "postcss-cli": "^11.0.1",
    "postcss-normalize": "^13.0.1",
    "postcss-preset-env": "^11.3.0",
    "sharp": "^0.34.5"
  }
}
